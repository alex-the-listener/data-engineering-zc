# ==========================================
# Terraform & Infrastructure
# ==========================================
# Local .terraform directories and plugins
.terraform/
.terraform.lock.hcl

# Local state files (contains sensitive resource metadata)
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraformrc
terraform.rc

# Crash logs and plans
crash.log
crash.*.log
*tfplan*

# ==========================================
# Credentials & Secrets (GCP / AWS / API Keys)
# ==========================================
# Service account keys and local auth secrets
*.json
*.pem
*.key
.env
.env.*

# Exclude specific JSON safe files if needed (e.g., !package.json)

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
*.egg-info/
.pytest_cache/

# ==========================================
# Operating System & IDE Artifacts
# ==========================================
# OS system files
.DS_Store
Thumbs.db

# VS Code settings and local workspace configs
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints